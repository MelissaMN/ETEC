<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventosApp.Views.ResumoEventoPage"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Evento Cadastrado com Sucesso!"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   HorizontalOptions="Center" />

            <Border Stroke="#CCCCCC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15">

                <VerticalStackLayout Spacing="12">

                    <Label Text="{Binding Nome}"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Local: " FontAttributes="Bold" />
                                <Span Text="{Binding Local}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Data de Início: " FontAttributes="Bold" />
                                <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Data de Término: " FontAttributes="Bold" />
                                <Span Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Duração: " FontAttributes="Bold" />
                                <Span Text="{Binding DuracaoEmDias, StringFormat='{0} dia(s) '}" />
                                <Span Text="{Binding Duracao, StringFormat='({0:dd\.hh\:mm} horas totais)'}" TextColor="Gray" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Participantes: " FontAttributes="Bold" />
                                <Span Text="{Binding NumeroParticipantes}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Custo por Participante: " FontAttributes="Bold" />
                                <Span Text="{Binding CustoPorParticipante, StringFormat='{0:C2}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <Label FontSize="18">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Custo Total Estimado: " FontAttributes="Bold" />
                                <Span Text="{Binding CustoTotal, StringFormat='{0:C2}'}"
                                      FontAttributes="Bold"
                                      TextColor="#512BD4" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar e Cadastrar Novo"
                    Margin="0,15,0,0"
                    Clicked="OnVoltarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
